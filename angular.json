{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-linkifyjs-v2": {
      "projectType": "library",
      "root": "projects/ngx-linkifyjs-v2",
      "sourceRoot": "projects/ngx-linkifyjs-v2/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "projects/ngx-linkifyjs-v2/tsconfig.lib.json",
            "project": "projects/ngx-linkifyjs-v2/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-linkifyjs-v2/tsconfig.lib.prod.json"
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-linkifyjs-v2/**/*.ts",
              "projects/ngx-linkifyjs-v2/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "@angular-eslint/schematics"
    ],
    "analytics": false
  },
  "schematics": {
    "@angular-eslint/schematics:application": {
      "setParserOptionsProject": true
    },
    "@angular-eslint/schematics:library": {
      "setParserOptionsProject": true
    }
  },
  "defaultProject": "ngx-linkifyjs-v2"
}
