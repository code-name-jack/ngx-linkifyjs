{
  "name": "ngx-linkifyjs-v2",
  "version": "22.0.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build ngx-linkifyjs-v2 && npm run --prefix projects/ngx-linkifyjs-v2 postbuild",
    "build:prod": "ng build ngx-linkifyjs-v2 --configuration production && npm run --prefix projects/ngx-linkifyjs-v2 postbuild",
    "build:docs": "npx compodoc -p projects/ngx-linkifyjs-v2/tsconfig.lib.json --hideGenerator --disableCoverage -d dist/doc/",
    "publish:lib": "npm publish ./dist/ngx-linkifyjs-v2",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint ngx-linkifyjs-v2",
    "release": "release-it",
    "demo": "npm run build && ng serve demo",
    "demo:build": "npm run build && ng build demo",
    "demo:build:prod": "npm run build:prod && ng build demo --configuration production"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.4",
    "@angular/core": "^22.0.4",
    "@angular/forms": "^22.0.4",
    "@angular/router": "^22.0.4",
    "linkify-plugin-hashtag": "^4.3.3",
    "linkify-plugin-mention": "^4.3.3",
    "linkify-string": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.0.4",
    "@angular-devkit/schematics": "^22.0.4",
    "@angular-eslint/builder": "22.0.0",
    "@angular-eslint/eslint-plugin": "22.0.0",
    "@angular-eslint/eslint-plugin-template": "22.0.0",
    "@angular-eslint/schematics": "22.0.0",
    "@angular-eslint/template-parser": "22.0.0",
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler": "^22.0.4",
    "@angular/compiler-cli": "^22.0.4",
    "@angular/language-service": "^22.0.4",
    "@compodoc/compodoc": "^1.2.1",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "angular-eslint": "^22.0.0",
    "eslint": "10.6.0",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.0.0",
    "release-it": "^20.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
