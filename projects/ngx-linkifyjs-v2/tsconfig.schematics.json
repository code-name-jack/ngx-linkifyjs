{
  "compilerOptions": {
    "lib": [
      "es2018",
      "dom"
    ],
    "declaration": true,
    "module": "Node16",
    "moduleResolution": "node16",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "rootDir": "schematics",
    "outDir": "../../dist/ngx-linkifyjs-v2/schematics",
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strictNullChecks": true,
    "target": "es6",
    "types": [
      "node"
    ]
  },
  "include": [
    "schematics/ng-add/**/*",
    "schematics/helpers/dependencies.ts",
    "schematics/helpers/index.ts",
    "schematics/collection.json"
  ],
  "exclude": [
    "schematics/helpers/angular/**/*",
    "schematics/helpers/material/**/*"
  ]
}
